# ローカル開発（docker compose -f compose.dev.yml up -d）の既定値。
# 本番・Preview では LiveKit Cloud（または自前の LiveKit）と自宅の PostgREST の値に差し替える。
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
# 保存先の PostgREST（design.md D1）。ローカルは compose.dev.yml、本番は https://db.suibari.com
DB_URL=http://127.0.0.1:3399
# ローカルの PostgREST 専用の JWT（role=nagi_space_api）。本番で anon ロールに権限を与えるなら空にする
POSTGREST_JWT=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoibmFnaV9zcGFjZV9hcGkifQ.XOyByCJks8EaIwpIejNqUAXa789w9CFbLEBG-JdphWQ
# 本番の Cloudflare Access のサービストークン（ローカルでは不要）
CF_ACCESS_CLIENT_ID_DB=
CF_ACCESS_CLIENT_SECRET_DB=

# 認証（ローカルは http://127.0.0.1:5173 で開く。localhost ではループバックとして扱われない）
PUBLIC_ORIGIN=http://127.0.0.1:5173
# 32文字以上の乱数。例: openssl rand -base64 48
SESSION_SECRET=
# 本番の confidential client の秘密鍵（ES256 の JWK を1行のJSONで）。ローカルでは不要
OAUTH_PRIVATE_KEY_JWK=
# SSOチケットの発行者（省略時は https://nagi-api.suibari.com）
NAGI_PASSPORT_ISSUER=
# Nagi AppView の URL（省略時は https://nagi-api.suibari.com）
NAGI_APPVIEW_URL=
# botたんの3Dモデル。開発はローカルのフォルダ（scripts/build-bot-assets.mjs の出力）、
# 本番は非公開の R2 の読み取り用の鍵（署名付き URL で配る）
BOT_ASSETS_DIR=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PREFIX=
